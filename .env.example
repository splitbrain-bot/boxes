# Everything here is OPTIONAL. Boxes runs with no .env at all:
#
#   docker compose -f compose.yaml -f compose.local.yaml up -d
#
# Copy this file only when you want to change something. The two exceptions are
# noted below: putting Boxes behind Traefik needs BASE_DOMAIN and
# BASICAUTH_USERS, because a domain and a password cannot have defaults.

# ---- behind Traefik ----
# Needed only for `docker compose up -d` (the Traefik path), and unused by
# compose.local.yaml. Without BASICAUTH_USERS the proxied routes reject every
# request, which is the safe way for an unconfigured deployment to fail.
#BASE_DOMAIN=agents.example.com
#BASICAUTH_USERS=owner:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxx   # htpasswd -nB owner, $ escaped as $$
#TRAEFIK_NETWORK=traefik
#CERT_RESOLVER=le

# ---- credentials ----
# Without a Claude token, sessions start and the gateway works, but no agent
# turn can run. `claude setup-token` prints one; it uses your subscription
# rather than an API key.
#
# This file is read by anything with access to the working directory. If you
# would rather the token not sit here, see "Keeping the token out of .env" in
# the README.
#PROFILE_DEFAULT_CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#PROFILE_DEFAULT_GH_TOKEN=ghp_...            # classic PAT for the bot account
#PROFILE_DEFAULT_GIT_NAME=boxes-bot
#PROFILE_DEFAULT_GIT_EMAIL=boxes-bot@users.noreply.github.com

# ---- gateway ----
# Left unset, the orchestrator generates a token on first boot and keeps it in
# the data volume, so it survives restarts. Set one here to pin or rotate it.
#WS_AUTH_TOKEN=

# ---- sessions ----
#SESSION_IMAGE=boxes-session:latest
#SESSION_SUBNET_POOL=10.200.0.0/16
#SESSION_MEM_LIMIT=4g
#SESSION_CPUS=2
#SESSION_PIDS_LIMIT=512
#IDLE_STOP_MINUTES=30

# ---- permissions ----
# hold | deny -- what to do with a permission request nobody answered in time.
#PERMISSION_FALLBACK=hold
#PERMISSION_HOLD_MINUTES=120
#NTFY_URL=                                   # POSTed when an approval is waiting
