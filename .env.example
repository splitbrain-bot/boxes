# ---- deployment ----
BASE_DOMAIN=agents.example.com
TRAEFIK_NETWORK=traefik
# htpasswd-style user:hash pairs for Traefik basicauth (escape $ as $$ in compose env)
BASICAUTH_USERS=owner:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxx

# ---- orchestrator ----
DATA_DIR=/data
SESSION_IMAGE=boxes-session:latest
SESSION_SUBNET_POOL=10.200.0.0/16
SESSION_MEM_LIMIT=4g
SESSION_CPUS=2
SESSION_PIDS_LIMIT=512
IDLE_STOP_MINUTES=30

# 64 random hex chars: openssl rand -hex 32
# Validated against the `bearer.<token>` WebSocket subprotocol on /ws.
WS_AUTH_TOKEN=

# hold | deny  -- what to do with a permission request nobody answered
PERMISSION_FALLBACK=hold
PERMISSION_HOLD_MINUTES=120

# optional ntfy topic URL, POSTed when an approval is waiting with no browser attached
NTFY_URL=

# ---- default session profile ----
# `claude setup-token` output; used instead of an API key so the subscription applies.
PROFILE_DEFAULT_CLAUDE_CODE_OAUTH_TOKEN=
# classic PAT for the bot account
PROFILE_DEFAULT_GH_TOKEN=
PROFILE_DEFAULT_GIT_NAME=mybot
PROFILE_DEFAULT_GIT_EMAIL=mybot@users.noreply.github.com
