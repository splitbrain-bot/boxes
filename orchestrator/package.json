{
  "name": "boxes-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --packages=external",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "better-sqlite3": "^11.8.1",
    "dockerode": "^4.0.4",
    "fastify": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
