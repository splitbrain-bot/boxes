{
  "name": "boxes-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "esbuild src/main.tsx --bundle --minify --format=esm --outdir=dist --loader:.css=css && cp src/index.html dist/index.html",
    "dev": "esbuild src/main.tsx --bundle --format=esm --outdir=dist --loader:.css=css --watch --servedir=dist",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "preact": "^10.25.4",
    "preact-iso": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.13.1"
  }
}
